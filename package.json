{
  "name": "newzealand-2d-live-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js",
    "deploy": "node scripts/deploy.mjs",
    "deploy:code": "npx wrangler deploy --config wrangler.jsonc",
    "db:apply": "npx wrangler d1 execute newzealand-2d-official-db --remote --file=schema.sql",
    "test": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
