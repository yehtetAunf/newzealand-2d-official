{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newzealand-2d-official",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },

  "vars": {
    "API_URL": "https://nz-six-times-2d-2026.yehtetaung7655.workers.dev/api/state",
    "POSTER_BACKGROUND_URL": "https://raw.githubusercontent.com/yehtetAunf/newzealand-2d-official/main/images/result.jpg.jpg"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newzealand-2d-official-db",
      "database_id": "7d23a7d1-67d9-4afe-8800-b8b4ac6765e0"
    }
  ],

  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  }
}
