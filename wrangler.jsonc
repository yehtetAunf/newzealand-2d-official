{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newzealand-2d-official",
  "main": "index.js",
  "compatibility_date": "2026-07-25",

  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newzealand-2d-official-db",
      "database_id": "7d23a7d1-67"
    }
  ]
}
