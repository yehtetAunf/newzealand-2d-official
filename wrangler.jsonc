{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newzealand-2d-live-bot",
  "main": "index.js",
  "compatibility_date": "2026-07-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newzealand-2d-live-bot-db",
      "database_id": "RUN_NPM_RUN_DEPLOY_TO_FILL_AUTOMATICALLY"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
